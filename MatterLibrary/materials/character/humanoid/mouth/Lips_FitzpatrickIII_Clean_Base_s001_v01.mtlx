<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01">
    <input name="base_color_tint" type="color3" value="1.0, 1.0, 1.0" uiname="Base Color Tint" />
    <input name="roughness_bias" type="float" value="0.0" uiname="Roughness Bias" />
    <input name="base_color_map" type="filename" value="../../../../textures/fit/makehuman/skin/FitzpatrickIII_basecolor_sUKN.png" uiname="Base Color Map" />
    <input name="normal_map" type="filename" value="../../../../textures/fit/makehuman/skin/Skin_normal_sUKN.png" uiname="Normal Map" />
    <input name="cavity_map" type="filename" value="../../../../textures/fit/makehuman/skin/Skin_cavity_sUKN.png" uiname="Cavity Map" />
    <constant name="base_color_const" type="color3">
      <input name="value" type="color3" value="0.8897, 0.6114, 0.5224" />
    </constant>
    <texcoord name="base_color_map_uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <image name="base_color_map_tex" type="color3" colorspace="srgb_texture">
      <input name="file" type="filename" interfacename="base_color_map" />
      <input name="default" type="color3" value="1.0, 1.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="base_color_map_uv" />
    </image>
    <multiply name="base_color_mapped" type="color3">
      <input name="in1" type="color3" nodename="base_color_const" />
      <input name="in2" type="color3" nodename="base_color_map_tex" />
    </multiply>
    <multiply name="base_color_tinted" type="color3">
      <input name="in1" type="color3" nodename="base_color_mapped" />
      <input name="in2" type="color3" interfacename="base_color_tint" />
    </multiply>
    <output name="base_color_out" type="color3" nodename="base_color_tinted" />
    <constant name="roughness_const" type="float">
      <input name="value" type="float" value="0.35" />
    </constant>
    <add name="roughness_biased" type="float">
      <input name="in1" type="float" nodename="roughness_const" />
      <input name="in2" type="float" interfacename="roughness_bias" />
    </add>
    <clamp name="roughness_biased_clamped" type="float">
      <input name="in" type="float" nodename="roughness_biased" />
      <input name="low" type="float" value="0.0" />
      <input name="high" type="float" value="1.0" />
    </clamp>
    <output name="roughness_out" type="float" nodename="roughness_biased_clamped" />
    <constant name="surface_normal_flat" type="vector3">
      <input name="value" type="vector3" value="0.0, 0.0, 1.0" />
    </constant>
    <texcoord name="shine_map_uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <image name="normal_map_tex" type="vector3">
      <input name="file" type="filename" interfacename="normal_map" />
      <input name="default" type="vector3" value="0.5, 0.5, 1.0" />
      <input name="texcoord" type="vector2" nodename="shine_map_uv" />
    </image>
    <multiply name="normal_map_ts_x2" type="vector3">
      <input name="in1" type="vector3" nodename="normal_map_tex" />
      <input name="in2" type="float" value="2.0" />
    </multiply>
    <subtract name="normal_map_ts" type="vector3">
      <input name="in1" type="vector3" nodename="normal_map_ts_x2" />
      <input name="in2" type="float" value="1.0" />
    </subtract>
    <multiply name="normal_map_xy" type="vector3">
      <input name="in1" type="vector3" nodename="normal_map_ts" />
      <input name="in2" type="vector3" value="1.0, 1.0, 0.0" />
    </multiply>
    <add name="normal_mapped" type="vector3">
      <input name="in1" type="vector3" nodename="surface_normal_flat" />
      <input name="in2" type="vector3" nodename="normal_map_xy" />
    </add>
    <normalize name="normal_out_unit" type="vector3">
      <input name="in" type="vector3" nodename="normal_mapped" />
    </normalize>
    <multiply name="normal_ts_half" type="vector3">
      <input name="in1" type="vector3" nodename="normal_out_unit" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="normal_ts_encoded" type="vector3">
      <input name="in1" type="vector3" nodename="normal_ts_half" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <normalmap name="surface_normal" type="vector3">
      <input name="in" type="vector3" nodename="normal_ts_encoded" />
    </normalmap>
    <output name="normal_out" type="vector3" nodename="surface_normal" />
    <image name="cavity_map_tex" type="float">
      <input name="file" type="filename" interfacename="cavity_map" />
      <input name="default" type="float" value="1.0" />
      <input name="texcoord" type="vector2" nodename="shine_map_uv" />
    </image>
    <multiply name="specular_weight_mapped" type="float">
      <input name="in1" type="float" nodename="cavity_map_tex" />
      <input name="in2" type="float" value="1.0" />
    </multiply>
    <output name="specular_weight_out" type="float" nodename="specular_weight_mapped" />
  </nodegraph>
  <open_pbr_surface name="SR_Lips_FitzpatrickIII_Clean_Base_s001_v01" type="surfaceshader">
    <input name="base_weight" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="base_color_out" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="roughness_out" />
    <input name="specular_ior" type="float" value="1.4" />
    <input name="geometry_normal" type="vector3" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="normal_out" />
    <input name="geometry_coat_normal" type="vector3" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="normal_out" />
    <input name="subsurface_weight" type="float" value="1.0" />
    <input name="subsurface_color" type="color3" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="base_color_out" />
    <input name="subsurface_radius" type="float" value="0.00482" />
    <input name="subsurface_radius_scale" type="color3" value="1.0, 0.351, 0.226" />
    <input name="subsurface_scatter_anisotropy" type="float" value="0.8" />
    <input name="coat_weight" type="float" value="0.3" />
    <input name="coat_roughness" type="float" value="0.2" />
    <input name="coat_ior" type="float" value="1.336" />
    <input name="specular_weight" type="float" nodegraph="NG_Lips_FitzpatrickIII_Clean_Base_s001_v01" output="specular_weight_out" />
  </open_pbr_surface>
  <surfacematerial name="Lips_FitzpatrickIII_Clean_Base_s001_v01" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Lips_FitzpatrickIII_Clean_Base_s001_v01" />
