<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_IMRSV_MissingMaterial">
    <constant name="base_color_const" type="color3">
      <input name="value" type="color3" value="1.0, 0.0, 1.0" />
    </constant>
    <output name="base_color_out" type="color3" nodename="base_color_const" />
    <constant name="roughness_const" type="float">
      <input name="value" type="float" value="0.4" />
    </constant>
    <output name="roughness_out" type="float" nodename="roughness_const" />
