      <input name="low" type="float" value="0.0" />
      <input name="high" type="float" value="1.0" />
    </clamp>
    <output name="roughness_out" type="float" nodename="roughness_biased_clamped" />
  </nodegraph>
  <open_pbr_surface name="SR_Rubber_Natural_Clean_Base_s001_v01" type="surfaceshader">
    <input name="base_weight" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_Rubber_Natural_Clean_Base_s001_v01" output="base_color_out" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" nodegraph="NG_Rubber_Natural_Clean_Base_s001_v01" output="roughness_out" />
    <input name="specular_ior" type="float" value="1.52" />
  </open_pbr_surface>
  <surfacematerial name="Rubber_Natural_Clean_Base_s001_v01" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_Rubber_Natural_Clean_Base_s001_v01" />
  </surfacematerial>
  <nodedef name="ND_imrsv_metadata" node="imrsv_metadata" nodegroup="metadata">
