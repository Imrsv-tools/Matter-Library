<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_Rubber_Natural_Clean_Base_s001_v01">
    <input name="base_color_tint" type="color3" value="1.0, 1.0, 1.0" uiname="Base Color Tint" />
    <input name="roughness_bias" type="float" value="0.0" uiname="Roughness Bias" />
    <constant name="base_color_const" type="color3">
      <input name="value" type="color3" value="0.035, 0.035, 0.035" />
    </constant>
    <multiply name="base_color_tinted" type="color3">
      <input name="in1" type="color3" nodename="base_color_const" />
      <input name="in2" type="color3" interfacename="base_color_tint" />
