<?xml version="1.0"?>
<materialx version="1.39">
  <nodedef name="ND_imrsv_metadata" node="imrsv_metadata" nodegroup="utility">
    <input name="master_material" type="string" />
    <input name="scale_tag" type="string" />
    <input name="meters_per_tile" type="float" />
    <input name="domain" type="string" />
    <input name="class" type="string" />
  </nodedef>

  <standard_surface name="SR_abs_matte" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.7, 0.7, 0.7" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" value="0.7" />
    <input name="specular_IOR" type="float" value="1.5" />
  </standard_surface>

  <surfacematerial name="M_abs_matte" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_abs_matte" />
  </surfacematerial>

  <imrsv_metadata name="IMRSV_Metadata">
    <input name="master_material" type="string" value="M_MasterMaterial_Opaque" />
    <input name="scale_tag" type="string" value="s01" />
    <input name="meters_per_tile" type="float" value="0.1" />
    <input name="domain" type="string" value="synthetic" />
    <input name="class" type="string" value="plastic" />
  </imrsv_metadata>
</materialx>
