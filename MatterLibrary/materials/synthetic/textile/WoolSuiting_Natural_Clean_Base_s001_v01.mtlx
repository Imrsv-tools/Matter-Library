<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_WoolSuiting_Natural_Clean_Base_s001_v01">
    <input name="base_color_tint" type="color3" value="1.0, 1.0, 1.0" uiname="Base Color Tint" />
    <input name="uv_scale" type="vector2" value="1.0, 1.0" uiname="UV Scale" />
    <input name="uv_offset" type="vector2" value="0.0, 0.0" uiname="UV Offset" />
    <input name="uv_rotation" type="float" value="0.0" uiname="UV Rotation (deg)" unittype="angle" unit="degree" />
    <input name="roughness_bias" type="float" value="0.0" uiname="Roughness Bias" />
    <texcoord name="geom_uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <place2d name="uv_place" type="vector2">
      <input name="texcoord" type="vector2" nodename="geom_uv" />
      <input name="scale" type="vector2" interfacename="uv_scale" />
      <input name="offset" type="vector2" interfacename="uv_offset" />
      <input name="rotate" type="float" interfacename="uv_rotation" />
    </place2d>
    <constant name="base_color_const" type="color3">
      <input name="value" type="color3" value="0.64, 0.61, 0.54" />
    </constant>
    <multiply name="base_color_tinted" type="color3">
      <input name="in1" type="color3" nodename="base_color_const" />
      <input name="in2" type="color3" interfacename="base_color_tint" />
    </multiply>
    <output name="base_color_out" type="color3" nodename="base_color_tinted" />
    <image name="roughness_tex" type="float">
      <input name="file" type="filename" value="../../../textures/base/synthetic/textile/Wool_Suiting_roughness_s001.png" />
      <input name="texcoord" type="vector2" nodename="uv_place" />
    </image>
    <add name="roughness_biased" type="float">
      <input name="in1" type="float" nodename="roughness_tex" />
      <input name="in2" type="float" interfacename="roughness_bias" />
    </add>
    <clamp name="roughness_biased_clamped" type="float">
      <input name="in" type="float" nodename="roughness_biased" />
      <input name="low" type="float" value="0.0" />
      <input name="high" type="float" value="1.0" />
    </clamp>
    <output name="roughness_out" type="float" nodename="roughness_biased_clamped" />
    <image name="normal_tex" type="vector3">
      <input name="file" type="filename" value="../../../textures/base/synthetic/textile/Wool_Suiting_normal_s001.png" />
      <input name="texcoord" type="vector2" nodename="uv_place" />
    </image>
    <normalmap name="surface_normal" type="vector3">
      <input name="in" type="vector3" nodename="normal_tex" />
    </normalmap>
    <output name="normal_out" type="vector3" nodename="surface_normal" />
  </nodegraph>
  <open_pbr_surface name="SR_WoolSuiting_Natural_Clean_Base_s001_v01" type="surfaceshader">
    <input name="base_weight" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_WoolSuiting_Natural_Clean_Base_s001_v01" output="base_color_out" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" nodegraph="NG_WoolSuiting_Natural_Clean_Base_s001_v01" output="roughness_out" />
    <input name="specular_ior" type="float" value="1.55" />
    <input name="geometry_normal" type="vector3" nodegraph="NG_WoolSuiting_Natural_Clean_Base_s001_v01" output="normal_out" />
    <input name="fuzz_weight" type="float" value="0.35" />
    <input name="fuzz_color" type="color3" value="0.8, 0.78, 0.72" />
    <input name="fuzz_roughness" type="float" value="0.5" />
  </open_pbr_surface>
  <surfacematerial name="WoolSuiting_Natural_Clean_Base_s001_v01" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_WoolSuiting_Natural_Clean_Base_s001_v01" />
  </surfacematerial>
  <nodedef name="ND_imrsv_metadata" node="imrsv_metadata" nodegroup="metadata">
    <output name="out" type="string" />
    <input name="master_material" type="string" value="Opaque" uniform="true" />
    <input name="scale_tag" type="string" value="s001" uniform="true" />
    <input name="meters_per_tile" type="float" value="0.01" />
    <input name="domain" type="string" value="synthetic" uniform="true" />
    <input name="class" type="string" value="textile" uniform="true" />
  </nodedef>
</materialx>
