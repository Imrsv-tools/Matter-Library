<?xml version="1.0"?>
<materialx version="1.39">

  <!-- 
    ================================================================================
    Matter Library: First Test Material
    Name: synthetic_plastic_abs-matte_clean_01_8k_v001
    MasterMaterial: M_MasterMaterial_Opaque
    ================================================================================
  -->

  <!-- 
    The standard_surface shader is the MaterialX equivalent to
    Blender's Principled BSDF and Unreal's default PBR model.
    This is our "Least Common Denominator" shader.
  -->
  <standard_surface name="SR_abs_matte_plastic" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" value="0.7" />
    <input name="specular_IOR" type="float" value="1.5" /> <!-- IOR for plastic -->
  </standard_surface>

  <!-- 
    This defines the actual "material" that gets assigned to geometry.
    It connects our shader (SR_abs_matte_plastic) to the output.
  -->
  <surfacematerial name="M_abs_matte_plastic" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_abs_matte_plastic" />
  </surfacematerial>

  <!-- 
    Project-specific Metadata.
    This is where we'll store our custom Matter Library info.
    The conversion bridges will read this to know how to build the material.
  -->
  <nodedef name="ND_Matter_Metadata" node="Matter_Metadata">
      <input name="MasterMaterial" type="string" value="M_MasterMaterial_Opaque" />
      <input name="TextureScale_m" type="float" value="0.1" />
  </nodedef>
</materialx>
