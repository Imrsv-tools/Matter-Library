#usda 1.0
(
    """
    Standalone preview scene for ONE Matter article (template; filled by make_preview.py).

    A UV-mapped sphere with the article bound, under a dome plus a key light, seen by a
    fixed camera. usdrecord renders it headless to a PNG, and a viewer (usdview,
    USDLiveView) opens it directly. No Stage, no release.

    Three things make a real article render (Phase03 discovery P3); without them the
    render was solid white or one flat colour:
      * the article layer has no defaultPrim, so the reference names its root: </MaterialX>;
      * USD 26.03 ignores material:binding unless the prim applies MaterialBindingAPI;
      * an implicit Sphere has no UVs, so the sphere is a mesh carrying an `st` primvar.

    Path resolution: the .mtlx is referenced by ABSOLUTE filesystem path, because the scene
    is written outside the repo. Texture paths are relative INSIDE the .mtlx and resolve
    against it. PXR_MTLX_STDLIB_SEARCH_PATHS owns only the MaterialX stdlib nodedefs.

    Slots: <MTLX> <NAME> <POINTS> <COUNTS> <INDICES> <UVS>
    """
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "World"
{
    def DomeLight "Dome"
    {
        float inputs:intensity = 1
    }

    def DistantLight "Key"
    {
        float inputs:intensity = 3
        float3 xformOp:rotateXYZ = (-35, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def "Library" (
        prepend references = @<MTLX>@</MaterialX>
    )
    {
    }

    def Mesh "Ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [<POINTS>]
        normal3f[] normals = [<POINTS>] (
            interpolation = "vertex"
        )
        int[] faceVertexCounts = [<COUNTS>]
        int[] faceVertexIndices = [<INDICES>]
        texCoord2f[] primvars:st = [<UVS>] (
            interpolation = "vertex"
        )
        rel material:binding = </World/Library/Materials/<NAME>>
    }

    def Camera "Cam"
    {
        float focalLength = 50
        double3 xformOp:translate = (0, 0, 7.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
