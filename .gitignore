# Python bytecode / caches from the tools harness
__pycache__/
*.py[cod]

# The core-tier environment uv builds from uv.lock (pyproject.toml) — per machine, never shared
.venv/

# Blender auto-save backups
*.blend[0-9]

# Release-staging tree (Phase 60sq2.5) — a reproducible build artifact. The compressor is
# deterministic at the pinned encoder+flags (compress_textures.py), the freeze hash-lock
# (freeze_release.py) + the determinism gate guarantee integrity, so the (large) BCn .dds
# derivatives are regenerated via `stage_release.py build`, never committed.
library/staging/

# Parity-rig pictures, scorecards and job scenes (Phase05, tools/parity/rig.py) — review
# material, regenerated by one command, never committed.
library/parity/

# The Unreal test runtime (Phase06): everything Unreal generates is rebuilt by unreal/build.sh
# (no .uasset is committed, UR-F5); the package is a GitHub Release the driver downloads into
# unreal/package/ (Phase06 D2), never committed and never LFS.
unreal/package/
unreal/dist/
unreal/MatterRuntime/Binaries/
unreal/MatterRuntime/Intermediate/
unreal/MatterRuntime/Saved/
unreal/MatterRuntime/DerivedDataCache/
unreal/MatterRuntime/Content/
unreal/MatterRuntime/Build/
unreal/MatterRuntime/Packaged/

# Claude Code harness runtime state (per-machine, never shared)
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Editor swap / backup files
*.kate-swp
*.swp
*~
